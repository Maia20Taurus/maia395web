---
import Logo from "./Logo.astro";
import '../styles/global.css'
---

<style>
    .bar {
        position: fixed;
        left: 50%;
        width:300px;
        min-width:300px;
        height: 40px;
        top: 10px;
        transform: translate(-50%, 0);
        border-radius: 25px;
        display: flex;
        justify-content: center;
        align-items:center;
        box-shadow: 0px 1px 5px -1px var(--box-shadow-colour);
        background-color: var(--block-background-colour);
    }

    .navButton {
        font-size: 20px;
        font-weight: bold;
        width:100%;
        height:100%;
        display:flex;
        justify-content: center;
        align-items: center;
    }

    .navLink {
        text-decoration: none;
    }

    a:visited {
        text-decoration: none;
    }

    .desktop {
        display:flex;
    }
    .mobile {
        display:none;
        gap: 0px;
        padding: 0px;
        position: fixed;
        top:0%;
        box-shadow: 0px 1px 5px -1px var(--box-shadow-colour);
        box-sizing: border-box;
    }

    .mobileBar {
        display:none;
        width:100%;
        flex-direction: row;
        justify-content: space-between;
        align-items:center;
        box-sizing:border-box;
        background-color: var(--block-background-colour);
    }
    .mobileNav {
        width:100%;
        display: none;
        flex-direction:column;
        justify-content:flex-start;
        align-items: flex-end;
        font-size: 30px;
        padding-top:10px;
        padding-right:10px;
        gap:10px;
        box-sizing: border-box;
        max-height:0;
        overflow:hidden;
        transition: max-height 0.4s ease-in-out;
        background-color: var(--block-background-colour);
    }

    @media screen and (max-width: 800px) {
        .desktop {
            display:none;
        }
        .mobile {
            display:flex;
        }
        .mobileBar {
            display:flex;
        }
        .mobileNav {
            display:flex;
        }
    }

    #hamburgerButton:checked ~ .mobileNav {
        max-height:300px;
    }
    }
}
</style>

<div role="navigation" class="bar desktop">
    <div class="navButton"> <a class="navLink" href="/"> Home </a> </div>
    <div class="navButton"> <a class="navLink" href="/trains"> Trains </a> </div>
    <div class="navButton"> <a class="navLink" href="/meshtastic"> Mesh </a> </div>
</div>

<div role="navigation" class="mobile" style="width:100%;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;position:fixed;">
    <input hidden id="hamburgerButton" type="checkbox">

    <div class="mobileBar" style="padding: 10px 15px 0;">

        <div style="width:35%;display:flex;justify-content:center;align-items:center;"><Logo/></div>

        <label for="hamburgerButton" style="display:flex;flex-direction:column;justify-content:space-between;align-items:center;width:24px;height:16px;background:transparent;border:none;padding:0;cursor:pointer;">
            <input hidden id="hamburgerButton" style="position:relative;width:100%;height:100%;" type="checkbox">
            <div style="background-color:var(--main-text);border-radius:10px;width:100%;height:10%;"/>
            <div style="background-color:var(--main-text);border-radius:10px;width:100%;height:10%;"/>
            <div style="background-color:var(--main-text);border-radius:10px;width:100%;height:10%;"/>
        </label>
    </div>
    <div class="mobileNav">
        <a class="navLink" href="/"> Home </a>
        <a class="navLink" href="/trains"> Trains </a>
        <a class="navLink" href="/meshtastic"> Mesh </a>
    </div>
</div>

