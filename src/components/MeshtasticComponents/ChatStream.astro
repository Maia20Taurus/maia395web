---
import "../../styles/global.css";
import "../../styles/cards.css";
---

<div
    class="ChatBox card"
    id="ChatBox"
    style="width:100%;height:100%;box-sizing:border-box;gap:1rem;display:flex;flex-direction:column;justify-content:flex-start;align-items:flex-end;padding:0.5rem;overflow-y:scroll;"
>
</div>

<template>
    <div
        style="width:100%;height:auto;display:flex;flex-direction:column;justify-content:flex-start;align-items:flex-start;box-sizing:border-box;"
    >
        <div
            style="display:flex;flex-direction:row;justify-content:flex-start;align-items:center;width:1fr;height:1.2rem;gap:1rem;"
        >
            <p id="ShortName" style="font-size:1rem;">shortname</p>
            <p
                id="Timestamp"
                style="color: rgba(0, 0, 0, 0.6);font-size:0.8rem;display:flex;justify-content:flex-start;align-items:flex-end;"
            >
                timestamp
            </p>
        </div>
        <div id="Message" style="width:1fr;height:100%;font-size:1.3rem;">
            message
        </div>
    </div>
</template>

<script src="../../ts/ChatRoomHandler.ts"></script>
