---
import '../../styles/global.css'
---

<div style="width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;">
    <div class="ChatBox" id="ChatBox" style="width:100%;height:100%;gap:20px;display:flex;flex-direction:column;justify-content:flex-end:align-items:center;padding:20px;overflow-y:scroll;">
    </div>
</div>

<template>
<div style="width:100%;height:auto;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;box-sizing:border-box;">
    <div style="display:flex;flex-direction:row;justify-content:flex-start;align-items:center;width:100%;height:20px;gap:15px;">
        <p id="ShortName" style="font-size:1rem;">shortname</p>
        <p id="Timestamp" style="color: rgba(0, 0, 0, 0.6);font-size:0.8rem;display:flex;justify-content:flex-start;align-items:flex-end;">timestamp</p>
    </div>
    <div id="Message" style="width:100%;height:100%;font-size:1.3rem;">message</div>
</div>
</template>

<script src="../../ts/ChatRoomHandler.ts" />