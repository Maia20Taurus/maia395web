---
export const prerender = true

import '../styles/global.css'
import '../styles/cards.css'
import ImageCard from '../components/ImageCard.astro';
import GenericPageWrapper from '../components/GenericPageWrapper.astro';

import Class800Image from '../assets/DSC_7879.jpg';
import e300Image from '../assets/DSC_8002.jpg'
import e320Image from '../assets/DSC_8048.jpg'
import Class395Image from '../assets/DSC_8311.jpg'
import Class395Image2 from '../assets/DSC_8678.jpg'
import Class375Image from '../assets/DSC_9060.jpg'
import Class450Image from '../assets/DSC_6225.jpg'
import Class220Image from '../assets/DSC_7939.jpg'
import Class150Image from '../assets/DSC_7948.jpg'
import Class150Image2 from '../assets/DSC_7932.jpg'
import Class166Image from '../assets/DSC_7900.jpg'
---

<GenericPageWrapper>
    <div role="main" style="display:flex;flex-direction:column;align-items:center;gap:30px;padding:30px;width:100%;justify-content:center;max-width:100%;box-sizing:border-box;">
        <h1 style="width:70%;text-align:center;">Welcome! This is a collection of pictures I have taken of various trains that I'd like to share.</h1>
        <p>Copyright © 2026 Maia</p>
        <ImageCard title="Class 800" description="A class 800 spotted at beautiful Dawlish." image={Class800Image} alt="A class 800 in Dawlish"/>
        <ImageCard title="Class 395" description="A class 395 spotted near Ashford International during a sunset." image={Class395Image} alt="A class 395 near Ashford International"/>
        <ImageCard title="Class 395" description="Another class 395 near Ashford Intl that I quite like." image={Class395Image2} alt="A class 395 near Ashford International"/>
        <ImageCard title="Eurostar e300" description="An e300 near Ashford International" image={e300Image} alt="An e300 near Ashford International"/>
        <ImageCard title="Eurostar e320" description="An e320 near Ashford International" image={e320Image} alt="An e320 near Ashford International"/>
        <ImageCard title="Class 375" image={Class375Image} alt="A class 375 near Ashford International"/>
        <ImageCard title="Class 450" description="A class 450 passing Hersham station" image={Class450Image} alt="A class 450 passing Hersham station"/>
        <ImageCard title="Class 220" description="A class 220 at Dawlish" image={Class220Image} alt="Class 220 at Dawlish"/>
        <ImageCard title="Class 150" description="A class 150 at Dawlish" image={Class150Image} alt="Class 150 at Dawlish"/>
        <ImageCard title="Class 150" image={Class150Image2} alt="Another class 150 at Dawlish"/>
        <ImageCard title="Class 166" image={Class166Image} description="A class 166 at Dawlish" alt="Class 166 at Dawlish"/>

        
    </div>
</GenericPageWrapper>