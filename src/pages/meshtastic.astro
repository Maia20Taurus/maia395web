---
export const prerender = false;

import GenericPageWrapper from "../components/GenericPageWrapper.astro";
import ChatStream from "../components/MeshtasticComponents/ChatStream.astro";
import "../styles/cards.css";
import "../styles/global.css";
---

<GenericPageWrapper>
    <main style="height:100%;">
        <div
            class="container" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;width:1fr;height:100%;"
        >
            <p style="width:90%;height:1fr;text-align:center;font-size:1.3rem">
                This page is a work in progress. It shows live and historic
                messages seen by my meshtastic node.
            </p>

            <div style="width:95%;height:90%;box-sizing:border-box;"><ChatStream /></div>
        </div>
    </main>
</GenericPageWrapper>
