---
export const prerender = false

import GenericPageWrapper from "../components/GenericPageWrapper.astro";
import ChatStream from "../components/MeshtasticComponents/ChatStream.astro";
import '../styles/cards.css'
import '../styles/global.css'
---

<GenericPageWrapper>
    <main>
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;width;100%;">
        <h3 style="width:90%;text-align:center;"> This page is a work in progress.
        It will show a live chat of messages seen by my meshtastic node, which I often operate near Exeter, Devon.
        messages may occur sometimes, though I will eventually have the page show shortnames instead of node ids.
        Moreover, I plan to implement a database so that users (like you!) can see historical messages.</h3>
        
        <div style="width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-start;align-items:center;">
            <div class="card" style="width:95%">
                <ChatStream class="card" />
            </div>
    </div>
    </div>
    </main>

</GenericPageWrapper>