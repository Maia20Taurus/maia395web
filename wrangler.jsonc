{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "maia395web",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MESHCHAT_SERVER_DO",
        "class_name": "MeshChatServer",
      },
    ],
  },
  "exports": {
    "MeshChatServer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
}
