{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-20",
	"compatibility_flags": [
		"global_fetch_strictly_public",
	],
	"name": "my-astro-app",
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MESHCHAT_SERVER_DO",
				"class_name": "MeshChatServer"
			}
		],
    },
    "exports": {
    	"MeshChatServer": {
        	"type": "durable-object",
            "storage": "sqlite"
        }
    }
    
}